              {
                "kind": "text",
                "id": "",
                "text": "将本机启动时使用的 OpenCore 配置与相似电脑的可用设置进行比较，说明需要调整的项目并列出步骤。此操作只读，不会更改配置。系统会询问一次密码。",
                "children": []
              }
            ]
          },
          {
            "kind": "button",
            "id": "efichk",
            "text": "检查 EFI",
            "children": []
          }
        ]
      },
      {
        "kind": "status",
        "id": "efichkr",
        "text": "",
        "children": []
      },
      {
        "kind": "issues",
